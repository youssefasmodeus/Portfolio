    "        patience  = 12,\n",
    "        dropout   = 0.3,\n",
    "        augment   = True,\n",
    "        project   = \"/kaggle/working/kfold_runs\",\n",
    "        name      = f\"fold_{fold_idx}\",\n",
    "        exist_ok  = True,\n",
    "        verbose   = True,\n",
